# Copy this file to .env and fill in values for your chosen provider

# Option A: Anthropic API directly
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option B: AWS Bedrock
ANTHROPIC_MODEL=arn:aws:bedrock:your-region:your-account-id:application-inference-profile/your-profile-id
EMBED_MODEL=arn:aws:bedrock:your-region:your-account-id:application-inference-profile/your-profile-id
AWS_PROFILE=cultureamp-env/SomeProfile