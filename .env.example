# RAG Chatbot Configuration
# Copy this file to .env and modify as needed

# Required: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Performance Configuration Options
# These control startup behavior and performance characteristics

# Embedding Model Configuration
# Options: all-MiniLM-L6-v2 (default, good balance), paraphrase-MiniLM-L3-v2 (faster, smaller)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Startup Performance Settings
# Set to 'true' to enable lazy loading (components load when first used)
LAZY_LOADING=true

# Set to 'true' to process documents in background after server starts
BACKGROUND_DOCUMENT_PROCESSING=true

# Set to 'true' to skip all document processing on startup (fastest startup)
QUICK_START=false

# Set to 'true' to preload all components upfront (slower startup, faster first queries)
PRELOAD_COMPONENTS=false

# Anthropic Model Configuration
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Document Processing Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_RESULTS=5
MAX_HISTORY=2