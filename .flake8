[flake8]
max-line-length = 88
extend-ignore = E203, E266, E501, W503, F403, F401, E402, F841, F541, C901
max-complexity = 15
select = B,C,E,F,W,T4,B9
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .mypy_cache,
    .pytest_cache,
    .tox
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811
    backend/app.py:E402,F811